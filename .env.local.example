# Copy this file to .env.local and fill in real values.
# .env.local is already git-ignored — it will never be committed or pushed.

# --- Supabase ---
# Project Settings > API in your Supabase dashboard.
SUPABASE_URL=
# The "service_role" secret key (NOT the "anon public" key). This key can
# read/write everything, so it must only ever be used on the server.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ---
# Developers > API keys. Use a "sk_test_..." key while testing, switch to
# "sk_live_..." only when you're ready to accept real payments.
STRIPE_SECRET_KEY=
# Developers > Webhooks > your endpoint > "Signing secret". See SETUP.md.
STRIPE_WEBHOOK_SECRET=
# Filled in automatically the first time you run `npm run stripe:sync`.
STRIPE_PRODUCT_ID=

# --- Resend (transactional email) ---
RESEND_API_KEY=
# Must be on a domain you've verified in Resend. Use the Resend sandbox
# address below while testing locally.
EMAIL_FROM="Soccer Cubs <onboarding@resend.dev>"
# Where Contact/Birthday inquiry and new-signup notifications get sent.
OWNER_NOTIFICATION_EMAIL=

# --- Misc ---
# Any long random string — used to sign the "Manage My Subscription" email
# links. Generate one with: openssl rand -hex 32
BILLING_LINK_SECRET=
